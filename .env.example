# =============================================================================
# Omnisense Environment Configuration
# Copy this file to .env and adjust values as needed.
# =============================================================================

# --- Ollama / LLM -----------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
LLM_TEMPERATURE=0
LLM_CONTEXT_WINDOW=2048

# --- Whisper (Audio Transcription) ------------------------------------------
# Options: tiny, base, small, medium, large
# "small" is recommended for 8 GB RAM systems
WHISPER_MODEL_SIZE=small

# --- ChromaDB ----------------------------------------------------------------
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=omnisense_memory

# --- Ingestion Limits --------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
MAX_CONTEXT_CHUNKS=5

# --- Text Chunking -----------------------------------------------------------
CHUNK_SIZE=1500
CHUNK_OVERLAP=300

# --- Frontend → Backend URL --------------------------------------------------
# Inside Docker Compose, the Streamlit container talks to the API container
# by service name. Override for local development.
BACKEND_URL=http://omnisense-api:8000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
